NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Postgres (Neon / Supabase / any). Leave empty to use the embedded PGlite database in server/data (dev only).
DATABASE_URL=
JWT_SECRET=change-me-to-a-random-string-of-32-plus-characters
# Used by `npm run seed` to create the first owner account
ADMIN_EMAIL=owner@dhanya.test
ADMIN_PASSWORD=ChangeMe123!
# Public address of the site, where HitPay sends customers back after paying (e.g. https://mahana.sg). Optional in development.
SITE_URL=
# "Sign in with Google": create an OAuth 2.0 Client ID (type: Web application) at console.cloud.google.com → APIs & Services → Credentials,
# add your site (https://your-domain and http://localhost:5173) under Authorised JavaScript origins, then paste the Client ID here.
GOOGLE_CLIENT_ID=
# EasyParcel (courier booking and tracking): Developer Hub -> Apps -> your app -> Client ID / Client Secret.
EASYPARCEL_CLIENT_ID=
EASYPARCEL_CLIENT_SECRET=
# Online payments with HitPay (PayNow, cards). HitPay Dashboard -> Developers -> API Keys / Webhooks. Use the sandbox first.
HITPAY_API_KEY=
HITPAY_SALT=
# sandbox (testing, no real money) or live
HITPAY_ENV=sandbox
# Which methods to offer (HitPay codes); default paynow_online,card
HITPAY_METHODS=paynow_online,card
