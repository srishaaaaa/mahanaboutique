NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Postgres (Neon / Supabase / any). Leave empty to use the embedded PGlite database in server/data (dev only).
DATABASE_URL=
JWT_SECRET=change-me-to-a-random-string-of-32-plus-characters
# Used by `npm run seed` to create the first owner account
ADMIN_EMAIL=owner@dhanya.test
ADMIN_PASSWORD=ChangeMe123!
# Online payments (Stripe Checkout: PayNow, cards, GrabPay, Apple/Google Pay). Stripe Dashboard -> Developers -> API keys.
# Use the test key (sk_test_...) first. Turn on PayNow and the other methods in Dashboard -> Settings -> Payment methods.
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks: endpoint https://<your-domain>/api/payments/webhook, events checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, checkout.session.expired. Paste its signing secret:
STRIPE_WEBHOOK_SECRET=
# Public address of the site, where Stripe sends customers back after paying (e.g. https://mahana.sg). Optional in development.
SITE_URL=
# "Sign in with Google": create an OAuth 2.0 Client ID (type: Web application) at console.cloud.google.com → APIs & Services → Credentials,
# add your site (https://your-domain and http://localhost:5173) under Authorised JavaScript origins, then paste the Client ID here.
GOOGLE_CLIENT_ID=
